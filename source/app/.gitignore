/gpio_toggle/gpio_toggle
/gps_display/gps_display
/motor/motor
/mpu6050_display/mpu6050_display
/oled_display/oled_display
/servo_ctrl/servo_ctrl
/sht20_display/sht20_display
/sonic_display/sonic_display
/spi_display/spi_display
/spo2_sensor/spo2_sensor
